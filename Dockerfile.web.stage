FROM node:22-alpine AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG GITHUB_SHA=local
RUN npm run build && node -e "const fs=require('fs');const p='dist/index.html';const s=fs.readFileSync(p,'utf8');fs.writeFileSync(p,s.replace('</body>','<div class=rateapp-stage-badge>TEST · DEV</div><style>.rateapp-stage-badge{position:fixed;z-index:2147483647;left:12px;bottom:12px;pointer-events:none;background:#a42345;color:white;border-radius:7px;padding:6px 9px;font:700 11px system-ui}</style></body>'))"

FROM caddy:2-alpine
COPY deploy/Caddyfile.stage /etc/caddy/Caddyfile
COPY --from=build /src/dist/ /srv/
EXPOSE 8080
