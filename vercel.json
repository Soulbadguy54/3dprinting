{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/release-alerts",
      "schedule": "0 9 * * *"
    }
  ]
}
