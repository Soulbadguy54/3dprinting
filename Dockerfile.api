FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY api/ ./api/
COPY migrations/ ./migrations/
COPY alembic.ini ./
COPY deploy/api-entrypoint.sh /usr/local/bin/rateapp-api-entrypoint
RUN chmod 755 /usr/local/bin/rateapp-api-entrypoint
ENTRYPOINT ["/usr/local/bin/rateapp-api-entrypoint"]
EXPOSE 8000
CMD ["uvicorn", "api.index:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
